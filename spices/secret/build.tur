(defpackage tur-secret
  :name        "tur-secret"
  :version     "0.1.0"
  :description "Linear key material and crypto hygiene primitives for Turmeric"
  :license     "MIT"
  :spices #map{
    "test" #map{:url    "https://github.com/rjungemann/turmeric-spices"
                :ref    "test-v0.1.0"
                :subdir "spices/test"
                :optional true}
  }
  :exports #map{
    "secret/hygiene" ["secure-wipe-ptr!" "crypto-random-bytes!"
                      "crypto-random-source" "ct-eq-ptr?"]
  })
