(defpackage tur-crdt
  :name        "tur-crdt"
  :version     "0.1.0"
  :description "Conflict-free replicated data types: state-based counters over a join-semilattice."
  :license     "MIT"
  :spices #map{
    "test" #map{:url    "https://github.com/rjungemann/turmeric-spices"
             :ref    "test-v0.1.0"
             :subdir "spices/test"
             :optional true}
  }
  :exports #map{
    "crdt/lattice" ["map-merge-with" "join-all"]
    "crdt/causal"  ["Dot" "mk-dot" "dot-replica" "dot-counter"
                    "DotContext" "dotctx-new" "dotctx-witness" "dotctx-seen?"
                    "dotctx-next" "dotctx-count"]
    "crdt/orset"   ["ORSet" "orset-new" "orset-add" "orset-remove"
                    "orset-has?" "orset-count"]
    "crdt/set"     ["GSet" "gset-new" "gset-add" "gset-has?" "gset-count"
                    "TwoPSet" "twopset-new" "twopset-add" "twopset-remove"
                    "twopset-has?" "twopset-count"]
    "crdt/counter" ["replica"
                    "GCounter" "gcounter-new" "gcounter-bump" "gcounter-value"
                    "PNCounter" "pncounter-new" "pncounter-inc" "pncounter-dec"
                    "pncounter-value"]
  })
