;; B2 (RM-S2): the with-frozen region FORM. A multi-statement frozen region
;; reads the world (no despawn possible inside -- a compile error), returns a
;; computed int, and the cap is reused for a real despawn AFTER the region
;; (with-frozen borrows, it does not consume). See ecs/freeze.
;;
;; Expected output:
;;   30
;;   despawned
;;   ok

(defmodule freeze_region_reuse_test
  (export)

(import ecs/entity :refer [Entity entity-new slot-new generation-new])
(import ecs/freeze :refer [DespawnCap mint-despawn-cap with-frozen])

(defstruct World [a : int b : int])

(defn guarded-despawn! [^linear tok : (DespawnCap World) e : Entity]
                      : (DespawnCap World)
  ```c
  (void)e; return tok;
  ```)
(defn drop-cap [^linear tok : (DespawnCap World)] : nil
  ```c
  (void)tok;
  ```)
(defn get-a [^borrow w : World] #fx{} : int (.a w))
(defn get-b [^borrow w : World] #fx{} : int (.b w))

(defn main [] : int
  (let [w  (World 10 20)
        dc (:: (mint-despawn-cap) (DespawnCap World))
        e  (entity-new (slot-new 0) (generation-new 0))]
    ;; A multi-read frozen region returning a computed int. No despawn is
    ;; reachable in here -- the cap is borrowed away for the region's body.
    (let [sum (with-frozen dc
                (let [x (get-a w)
                      y (get-b w)]
                  (+ x y)))]
      (do
        (println sum)                         ;; 30
        ;; The borrow has ended: dc is usable again for a real despawn.
        (drop-cap (guarded-despawn! dc e))
        (println "despawned")
        (println "ok")
        0))))

) ;; end defmodule freeze_region_reuse_test
