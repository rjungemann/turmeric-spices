;; B1 (RM-S2): a frozen region borrows the world's linear despawn cap, so
;; inside it only read-only work runs; after the region the cap is usable
;; again and a real (cap-gated) despawn is allowed. See ecs/freeze.
;;
;; Expected output:
;;   3
;;   ok

(defmodule freeze_region_test
  (export)

(import ecs/entity :refer [Entity entity-new slot-new generation-new])
(import ecs/freeze :refer [DespawnCap mint-despawn-cap with-frozen])

(defstruct World [n : int])

;; A cap-gated despawn: consumes the linear cap and threads a fresh one back.
(defn guarded-despawn! [^linear tok : (DespawnCap World) e : Entity]
                      : (DespawnCap World)
  ```c
  (void)e; return tok;
  ```)
(defn drop-cap [^linear tok : (DespawnCap World)] : nil
  ```c
  (void)tok;
  ```)
(defn read-count [^borrow w : World] #fx{} : int (.n w))

(defn main [] : int
  (let [w  (World 3)
        dc (:: (mint-despawn-cap) (DespawnCap World))
        e  (entity-new (slot-new 0) (generation-new 0))]
    (let [total (with-frozen dc (read-count w))]
      (do
        (println total)
        ;; After the region the borrow has ended: the cap is consumable.
        (drop-cap (guarded-despawn! dc e))
        (println "ok")
        0))))

) ;; end defmodule freeze_region_test
