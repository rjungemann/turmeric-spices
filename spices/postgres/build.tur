(defpackage tur-postgres
  :name        "tur-postgres"
  :version     "0.4.0"
  :description "PostgreSQL client for Turmeric via libpq"
  :license     "MIT"
  :spices #map{
    "test" #map{:path   "../test"
                :url    "https://github.com/rjungemann/turmeric-spices"
                :ref    "test-v0.1.0"
                :subdir "spices/test"
                :optional true}
  }
  ;; libpq comes from the system; cmake-deps/postgres/CMakeLists.txt finds it
  ;; and re-exports it as a target named `pq`, because tur derives the -l name
  ;; from the target basename and PostgreSQL::PostgreSQL would give the
  ;; non-existent -lPostgreSQL.  :path is spliced in as
  ;; add_subdirectory("./<path>") relative to cmake/, hence the leading ../
  :cmake-deps #map{
    "libpq" #map{:path    "../cmake-deps/postgres"
                 :targets ["pq"]}
  }
  :exports #map{
    "postgres/db"     ["Conn"
                       "db-connect" "db-close" "db-exec" "db-query"
                       "db-query-params" "db-begin" "db-commit" "db-rollback"]
    "postgres/stmt"   ["stmt-prepare" "stmt-exec-prepared" "stmt-deallocate"]
    "postgres/row"    ["Rows"
                       "rows-count" "rows-free" "row-get" "row-get-int"
                       "col-count" "col-name"]
    "postgres/notify" ["Notification"
                       "notify-listen" "notify-unlisten" "notify-poll"
                       "notification-channel" "notification-payload"]
    "postgres/typed"  ["TRows" "trows-of" "trows-handle"
                       "trows-count" "trows-free"
                       "trow-get" "trow-get-int"
                       "tcol-count" "tcol-name"]
  })
