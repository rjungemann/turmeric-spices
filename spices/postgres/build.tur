(defpackage tur-postgres
  :name        "tur-postgres"
  :version     "0.4.0"
  :description "PostgreSQL client for Turmeric via libpq"
  :license     "MIT"
  :spices #map{
    "test" #map{:url    "https://github.com/rjungemann/turmeric-spices"
            :ref    "test-v0.1.0"
            :subdir "spices/test"
            :optional true}
  }
  :cmake-deps #map{
    ;; libpq is taken from the system (libpq-dev / brew libpq), never built
    ;; from source: there is no standalone libpq repo to FetchContent. Without
    ;; :prefer-system the generator emitted a FetchContent_Declare with no
    ;; GIT_REPOSITORY, which aborted the cmake configure -- so no manifest was
    ;; written, libpq-fe.h was never on the include path, and every test failed
    ;; to compile on "'PGconn' undeclared". :prefer-system makes it a
    ;; find_package(PostgreSQL) instead, which is what :cmake-name/:targets
    ;; were already written for.
    "libpq" #map{:prefer-system true
             :cmake-name "PostgreSQL"
             :targets    ["PostgreSQL::PostgreSQL"]}
  }
  :exports #map{
    "postgres/db"     ["Conn"
                       "db-connect" "db-close" "db-exec" "db-query"
                       "db-query-params" "db-begin" "db-commit" "db-rollback"]
    "postgres/stmt"   ["stmt-prepare" "stmt-exec-prepared" "stmt-deallocate"]
    "postgres/row"    ["Rows"
                       "rows-count" "rows-free" "row-get" "row-get-int"
                       "col-count" "col-name"]
    "postgres/notify" ["Notification"
                       "notify-listen" "notify-unlisten" "notify-poll"
                       "notification-channel" "notification-payload"]
    "postgres/typed"  ["TRows" "trows-of" "trows-handle"
                       "trows-count" "trows-free"
                       "trow-get" "trow-get-int"
                       "tcol-count" "tcol-name"]
  })
