;; tests/osc/client_test.tur -- tests for osc/client.
(defmodule osc/tests/client
  (import test/suite  :refer [describe it])
  (import test/assert :refer [assert-eq])
  (import test/runner :refer [run-all-status])

  (describe "osc/client"
    (it "module loads without error"
      (assert-eq 1 1)))


  (defn main [] : int
    (run-all-status)))
